<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Scrollable profile content -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#F8F9FF"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Profile image -->
            <ImageView
                android:id="@+id/profileImage"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/circle_background"
                android:scaleType="centerCrop"
                android:layout_marginBottom="10dp" />

            <!-- Edit Profile button (owner only) -->
            <Button
                android:id="@+id/btnEditProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit Profile"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1A73E8"
                android:layout_marginBottom="20dp" />

            <!-- ===== VIEW MODE ===== -->
            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your Name"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:gravity="center"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your Bio"
                android:textSize="16sp"
                android:textColor="#444444"
                android:gravity="center"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvSkills"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Skills"
                android:textSize="16sp"
                android:textColor="#444444"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <!-- ===== EDIT MODE (hidden initially) ===== -->
            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Full Name"
                android:background="@drawable/rounded_field"
                android:padding="12dp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etBio"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:hint="Bio"
                android:background="@drawable/rounded_field"
                android:padding="12dp"
                android:gravity="top"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etSkills"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Skills (comma separated)"
                android:background="@drawable/rounded_field"
                android:padding="12dp"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnUploadPic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upload Picture"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1A73E8"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Save Profile"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1A73E8"
                android:layout_marginTop="20dp"
                android:visibility="gone" />

            <!-- Logout button (owner only) -->
            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:layout_marginTop="16dp"
                android:textColor="@android:color/white" />

            <!-- Message button (visible when viewing other user) -->
            <Button
                android:id="@+id/btnMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Message"
                android:layout_marginTop="16dp"
                android:textColor="@android:color/white"
                android:backgroundTint="#00BCD4"
                android:visibility="gone" />

            <!-- Jobs posted -->
            <TextView
                android:id="@+id/postedHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jobs I Posted"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:layout_marginTop="30dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerPosted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp" />

            <!-- ❌ Removed Jobs Applied section -->

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>